rules_version = '2';

// Chitransh Firestore rules.
// - members/{uid}: each signed-in member can read and write only their own profile.
// - emailOtps, otpIpLimits, otpDaily: used only by the server (Firebase Admin ignores these rules); no browser access.
// - everything else: closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function optString(d, field, max) {
      return !(field in d) || (d[field] is string && d[field].size() <= max);
    }

    function validMember() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'fullName', 'email', 'phone', 'gender', 'seeking', 'kulId', 'gotra', 'city',
          'age', 'maritalStatus', 'profession', 'profileFor', 'photoURL', 'authMethod',
          'requestedIntroductions', 'createdAt', 'updatedAt',
          'uid', 'syncedAt'   // written by the old site; allowed so existing members can still update
        ])
        && optString(d, 'fullName', 200)
        && (!('email' in d) || d.email == request.auth.token.email)
        && optString(d, 'phone', 20)
        && (!('gender' in d) || d.gender in ['man', 'woman'])
        && (!('seeking' in d) || d.seeking in ['man', 'woman'])
        && optString(d, 'kulId', 60)
        && optString(d, 'gotra', 200)
        && optString(d, 'city', 200)
        && optString(d, 'age', 10)
        && optString(d, 'maritalStatus', 60)
        && optString(d, 'profession', 200)
        && optString(d, 'profileFor', 30)
        && optString(d, 'photoURL', 1000)
        && optString(d, 'authMethod', 60)
        && optString(d, 'createdAt', 40)
        && optString(d, 'updatedAt', 40)
        && (!('uid' in d) || d.uid == request.auth.uid)
        && optString(d, 'syncedAt', 40)
        && (!('requestedIntroductions' in d) || (d.requestedIntroductions is list && d.requestedIntroductions.size() <= 200));
    }

    match /members/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validMember();
      allow update: if isOwner(uid) && validMember()
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isOwner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
